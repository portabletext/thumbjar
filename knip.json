{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/bin.ts!",
    "src/guard.ts!",
    "src/prepare/*.ts!",
    "src/run/*.ts!",
    "package.config.ts!",
    "src/device/*.ts",
    "src/gboard/*.ts",
    "src/fixtures/suites/*.ts",
    "e2e/vitest.config.ts!",
    "e2e/tests/*.test.ts"
  ],
  "ignoreBinaries": ["adb"],
  "ignore": ["demo/**"]
}

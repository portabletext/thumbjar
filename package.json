{
  "name": "thumbjar",
  "version": "0.0.0",
  "private": true,
  "description": "Test rich text editors against a real Android or iOS keyboard",
  "homepage": "https://github.com/portabletext/thumbjar#readme",
  "bugs": {
    "url": "https://github.com/portabletext/thumbjar/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/portabletext/thumbjar.git"
  },
  "bin": {
    "thumbjar": "./bin/thumbjar.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./page": {
      "source": "./src/page.ts",
      "default": "./dist/page.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "default": "./dist/testing.js"
    },
    "./vitest": {
      "source": "./src/vitest/index.ts",
      "default": "./dist/vitest/index.js"
    },
    "./vitest/global-setup": {
      "source": "./src/vitest/global-setup.ts",
      "default": "./dist/vitest/global-setup.js"
    },
    "./vitest/setup": {
      "source": "./src/vitest/setup.ts",
      "default": "./dist/vitest/setup.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./page": "./dist/page.js",
      "./testing": "./dist/testing.js",
      "./vitest": "./dist/vitest/index.js",
      "./vitest/global-setup": "./dist/vitest/global-setup.js",
      "./vitest/setup": "./dist/vitest/setup.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pkg-utils build --strict --check",
    "check:format": "oxfmt --check .",
    "check:types": "tsc --noEmit --pretty --project tsconfig.json && tsc --noEmit --pretty --project tsconfig.page.json",
    "clean": "del dist && del out && del node_modules",
    "format": "oxfmt .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "find-cache-directory": "^6.0.0"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^12.3.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24",
    "del-cli": "^8.0.1",
    "jsdom": "^27.2.0",
    "oxfmt": "^0.80.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "webdriverio": "^9.27.1"
  },
  "peerDependencies": {
    "vitest": "^5.0.5",
    "webdriverio": "^9.27.1"
  },
  "peerDependenciesMeta": {
    "webdriverio": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.23.0"
}
